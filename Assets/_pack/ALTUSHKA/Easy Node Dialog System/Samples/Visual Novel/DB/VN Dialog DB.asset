          SayerName: 
          Text: Ask about the missing cheese
          VoiceClip: {fileID: 0}
        - LanguageCode: es
          SayerName: 
          Text: '[ES stub] Ask cheese'
          VoiceClip: {fileID: 0}
      - NextNodeId: 6326d367-00a0-4433-aaa2-7f5b4eaba2b1
