    - NodeType: 1
      nodeId: 08e1c432-b7c7-4c00-ab38-9730188f656d
      Position: {x: 178.43883, y: 1036.7727}
      StartData:
        NextNodeId: 
      LineData:
        CharacterName: Guard
        CharacterReferenceState: 0
        MissingCharacterReferenceLabel: 
        CharacterActions:
        - ReferenceState: 0
          MissingReferenceLabel: 
          CharacterName: Guard
          EmotionName: Talk
          Action: 0
          PosX: 420
          PosY: 0
          Zoom: 1
        DialogsText:
        - LanguageCode: en
          SayerName: Guard
          Text: Ambition smells like onions you forgot, Pip. And don't call me Crumb
            on duty.
          VoiceClip: {fileID: 0}
        - LanguageCode: es
          SayerName: Guard
          Text: '[ES stub] Guard: onions / duty.'
          VoiceClip: {fileID: 0}
        NextNodeId: 2f2b463a-7efe-49a7-b07b-ee00d7b292b6
