      Position: {x: 3073.4978, y: 1144.4994}
      StartData:
        NextNodeId: 
      LineData:
        CharacterName: Guard
        CharacterReferenceState: 0
        MissingCharacterReferenceLabel: 
        CharacterActions:
        - ReferenceState: 0
          MissingReferenceLabel: 
          CharacterName: Guard
          EmotionName: Talk
          Action: 0
          PosX: 420
          PosY: 0
          Zoom: 1
        DialogsText:
        - LanguageCode: en
          SayerName: Guard
          Text: I do not sleepwalk. I... strategically rest my eyes. The cheese was
            already gone.
          VoiceClip: {fileID: 0}
        - LanguageCode: es
          SayerName: Guard
          Text: '[ES stub] Guard denies sleepwalk.'
          VoiceClip: {fileID: 0}
