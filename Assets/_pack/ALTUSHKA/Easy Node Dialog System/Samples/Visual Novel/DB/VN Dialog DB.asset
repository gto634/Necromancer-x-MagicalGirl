          EmotionName: Talk
          Action: 0
          PosX: -420
          PosY: 0
          Zoom: 1
        DialogsText:
        - LanguageCode: en
          SayerName: Chef
          Text: Ah-ha! The big wheel walked off at midnight. Either ghosts love cheddar...
            or Crumb sleepwalks.
          VoiceClip: {fileID: 0}
        - LanguageCode: es
          SayerName: Chef
          Text: '[ES stub] Cheese walked off.'
          VoiceClip: {fileID: 0}
        NextNodeId: fff5e6d7-111e-44e6-a658-c7f6ed29c972
        isInstant: 0
      ChoiceData: []
      ConditionData:
        DialogConditions: []
        IsAndLogic: 1
        TrueNodeId: 
        FalseNodeId: 
      RedirectData:
        TargetCategory: 
        TargetDialogName: 
        DialogReferenceState: 0
        MissingDialogReferenceLabel: 
    - NodeType: 1
