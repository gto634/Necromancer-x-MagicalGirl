      StartData:
        NextNodeId: 
      LineData:
        CharacterName: Chef
        CharacterReferenceState: 0
        MissingCharacterReferenceLabel: 
        CharacterActions:
        - ReferenceState: 0
          MissingReferenceLabel: 
          CharacterName: Chef
          EmotionName: Talk
          Action: 0
