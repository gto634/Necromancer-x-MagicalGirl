      Position: {x: 2401.412, y: 658.353}
      StartData:
        NextNodeId: 
      LineData:
        CharacterName: Chef
        CharacterReferenceState: 0
        MissingCharacterReferenceLabel: 
        CharacterActions:
        - ReferenceState: 0
