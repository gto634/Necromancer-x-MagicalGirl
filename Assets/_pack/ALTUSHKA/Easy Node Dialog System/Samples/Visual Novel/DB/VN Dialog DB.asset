        ChoiceCondition: []
        IsAndLogic: 1
        ChoiceConsequence: []
        Translations:
        - LanguageCode: en
          SayerName: 
          Text: Slip away quietly
          VoiceClip: {fileID: 0}
        - LanguageCode: es
          SayerName: 
