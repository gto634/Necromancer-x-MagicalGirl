        IsAndLogic: 1
        ChoiceConsequence: []
        Translations:
        - LanguageCode: en
          SayerName: 
          Text: Ask about the night watch
          VoiceClip: {fileID: 0}
        - LanguageCode: es
          SayerName: 
          Text: '[ES stub] Ask watch'
          VoiceClip: {fileID: 0}
