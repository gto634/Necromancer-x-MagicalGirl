          Action: 0
          PosX: -420
          PosY: 0
          Zoom: 1
        DialogsText:
        - LanguageCode: en
          SayerName: Chef
          Text: On duty, off duty - you're still the rat who naps by the cheese shelf.
            Speak up, traveler!
