          CharacterName: Guard
          EmotionName: Neutral
          Action: 0
          PosX: 769
          PosY: -340
          Zoom: 0.36
        DialogsText:
        - LanguageCode: en
          SayerName: Chef
          Text: Oi, Crumb - sniff that? That ain't the stew. That's ambition burnin'
            on the pan.
          VoiceClip: {fileID: 0}
        - LanguageCode: es
          SayerName: Chef
          Text: '[ES stub] Chef: smell / ambition.'
          VoiceClip: {fileID: 0}
        NextNodeId: 08e1c432-b7c7-4c00-ab38-9730188f656d
